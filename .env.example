# --- Always ------------------------------------------------------------------
ANTHROPIC_API_KEY=
ADMIN_KEY=                  # long random string; protects the console and /api/*
MODE=demo                   # demo = nothing leaves the server; live = real WhatsApp + calls via Twilio
STORE=memory                # memory (demo/testing, lost on restart) or firestore (live)
PUBLIC_URL=https://dispatch-agent-xxxx.a.run.app   # exact public https URL (live mode)

# --- Live mode: Twilio -------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=       # your WhatsApp Business sender, E.164, e.g. +919xxxxxxxxx
TWILIO_VOICE_FROM=          # phone number for normal escalation calls (if not using WhatsApp calls)
WHATSAPP_CALLS=false        # true = escalation calls go to the person's WhatsApp (needs their call permission)
DISPATCHER_NUMBERS=         # comma-separated E.164 WhatsApp numbers that receive alerts

# Approved WhatsApp template Content SIDs (HX…) for starting conversations; see README
TEMPLATE_CLIENT_CONFIRM_EN=
TEMPLATE_CLIENT_CONFIRM_HI=
TEMPLATE_DRIVER_ETA_EN=
TEMPLATE_DRIVER_ETA_HI=
TEMPLATE_DISPATCHER_ALERT_EN=

# --- Order feed: Google Sheet (optional) ----------------------------------------
SHEET_ID=                   # from the sheet URL; share the sheet with the service account (Editor)
SHEET_TAB=Deliveries
SHEET_SYNC_SECONDS=120

# --- Storage (live) ------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=
FIREBASE_SERVICE_ACCOUNT=   # local dev only: service-account JSON on one line

# --- Behaviour (optional) -------------------------------------------------------
COMPANY_NAME=               # overrides config/dispatch.json
MODEL=claude-haiku-5-5      # fast, low-cost; claude-opus-5-5 for maximum quality
EFFORT=low
CALLS_ENABLED=true
CLIENT_CONFIRM_LEAD_MIN=120
NO_REPLY_MIN=20
TICK_SECONDS=60
ELEVENLABS_VOICE=
IDLE_MS=9000
CONFIG_FILE=config/dispatch.json

# --- Local development only -------------------------------------------------------
SKIP_SIGNATURE=false        # true skips Twilio signature checks (ignored when NODE_ENV=production)
